includes:
    - tools/qa/vendor/phpstan/phpstan-strict-rules/rules.neon
    - tools/qa/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/qa/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    phpVersion: 80200
    paths:
        - src
        - tests
        - tools
    excludePaths:
        - tools/qa
    # A property that exists to be held, and so is never read, says so.
    propertyAlwaysReadTags:
        - '@held'
    bootstrapFiles:
        - vendor/autoload.php
